# Allow Half-Life-specific files that would otherwise be ignored
!lib/public/SDL2.lib
!utils/procinfo/lib/win32_vc6/procinfo.lib
!utils/vgui/lib/win32_vc16/vgui.lib
*.vcxproj
.vs
# Python tool caches (utils/sprtool, utils/mdltool)
__pycache__/

# J.A.C.K.'s rolling backup of the previous .map, not an editor format (docs/MAP_WORKFLOW.md)
*.max

# J.A.C.K.'s own working files. The .map beside them is the source of truth; a .jmf is the
# editor's copy of it, overwritten from the .map after any text edit (docs/MAP_WORKFLOW.md)
maps/jmf/
*.jmf
*.jmx
